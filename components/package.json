{
	"name": "@swr-data-lab/components",
	"description": "SWR Data Lab component library",
	"version": "1.0.6",
	"author": "SWR Data Lab",
	"license": "UNLICENSED",
	"type": "module",
	"engines": {
		"node": "^24.18.0"
	},
	"keywords": [
		"svelte"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"url": "git+https://github.com/SWRdata/components.git"
	},
	"scripts": {
		"package": "svelte-package -i src && publint",
		"package:dev": "svelte-package -i src",
		"package:watch": "nodemon --watch src --ext svelte,js,ts,css --ignore '**/*.test.*' --ignore '**/*.spec.*' --ignore '**/*.stories.*' --exec 'npm run package:dev'",
		"prepublishOnly": "npm run package",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"semantic-release": "semantic-release"
	},
	"peerDependencies": {
		"svelte": ">=5.0.0"
	},
	"dependencies": {
		"esm-env": "^1.2.2",
		"fuse.js": "^7.4.2",
		"svelte-select": "5.8.3"
	},
	"devDependencies": {
		"@semantic-release/npm": "13.1.5",
		"@storybook/addon-docs": "10.5.5",
		"@storybook/addon-svelte-csf": "5.1.2",
		"@sveltejs/enhanced-img": "0.11.0",
		"@sveltejs/package": "2.5.8",
		"layercake": "^10.0.2",
		"nodemon": "^3.1.11",
		"publint": "0.3.17",
		"sass": "1.93.2",
		"sass-embedded": "1.97.3",
		"semantic-release": "25.0.8",
		"storybook": "10.5.5",
		"svelte": "5.55.7",
		"svelte-check": "4.5.0",
		"svelte-preprocess": "6.0.3",
		"typescript": "5.9.3"
	},
	"release": {
		"tagFormat": "components-v${version}",
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			"@semantic-release/npm"
		]
	},
	"files": [
		"dist/"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	}
}
